# Copy this file to terraform.tfvars and fill in your values
# Never commit terraform.tfvars to source control

resource_group_name     = "rg-demo-postgres"
location                = "eastus"
environment             = "dev"
postgres_server_name    = "psql-demo-server"
postgres_version        = "16"
postgres_sku_name       = "B_Standard_B1ms"
postgres_storage_mb     = 32768
postgres_admin_username = "psqladmin"
postgres_admin_password = "CHANGE_ME_strong_password_here!"
postgres_database_name  = "appdb"

# Restrict to your IP or VPN range in prod
allowed_ip_start = "0.0.0.0"
allowed_ip_end   = "0.0.0.0"

tags = {
  project    = "demo"
  managed_by = "terraform"
}
